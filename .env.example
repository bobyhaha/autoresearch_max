# Deployment facts for one operator. Copy to .env and fill in.
# .env and active execution files are gitignored. Templates describe their shape;
# each clone supplies its own machine facts. records.read_json expands ${VAR} in
# loaded configs and fails loudly if one is missing.
OPHIS_SSH_KEY=/absolute/path/to/your/ssh/private_key
OPHIS_SSH_PORT=22
OPHIS_SSH_TARGET=user@your-gpu-host.example.com
OPHIS_REMOTE_ROOT=/home/user/ophis_v3
OPHIS_HOST_ID=your-host-id
OPHIS_GPUS=0
OPHIS_EXECUTION_CONFIG=runs/execution.json
# Optional JSON mapping used by monitoring tools after physical UUIDs are observed.
# Example: {"GPU-replace":"gpu0"}
OPHIS_GPU_UUID_MAP={}
