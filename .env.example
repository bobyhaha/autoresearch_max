# Remote trainer target. Copy to .ophis_host (git-ignored) and fill in.
#   cp .env.example .ophis_host
# Environment variables of the same names override this file.
#
# Kept out of the repository deliberately: an address, a login and a port together are
# enough for someone to start knocking on the box.

OPHIS_SSH_USER=
OPHIS_SSH_HOST=
OPHIS_SSH_PORT=22
OPHIS_SSH_KEY=~/.ssh/id_ed25519

# Directory on the remote host holding sweep/, the venv, and prepare.py
OPHIS_REMOTE_DIR=ophis_v3
