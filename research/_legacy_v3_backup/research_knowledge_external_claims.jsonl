{"claim_id":"clm_r2_quant_scaling_law_qat_3","claim_type":"predictive","extracted_at":"2026-07-19","fingerprint":"f1a720693cdee7d7","limitations":["forward-looking implication from the fitted law"],"locator":"results","paper_id":"pap_r2_quant_scaling_law_qat","scope":{"implication":"joint weight+activation mitigation","trend":"more tokens -> higher QAT error"},"statement":"Because more training tokens raise QAT quantization error, extending token budgets for low-bit models needs mitigation of both weight and activation error to avoid diminishing returns at scale.","tags":["qat","token_scaling","low_bit"]}
