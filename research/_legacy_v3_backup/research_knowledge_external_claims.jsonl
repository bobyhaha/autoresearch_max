{"claim_id":"clm_r2_opt_dion_1","claim_type":"method_definition","extracted_at":"2026-07-19","fingerprint":"0bada9367300cbf5","limitations":["low-rank approximation introduces a rank-fraction hyperparameter","targets distributed setting"],"locator":"abstract","paper_id":"pap_r2_opt_dion","scope":{"family":"Muon/orthogonalized","parallelism":"DDP+FSDP+TP"},"statement":"Dion replaces Muon's Newton-Schulz orthogonalization with amortized power iteration on a decoupled momentum buffer plus low-rank approximation, producing orthonormalized updates without unsharding the full weight matrix on any device.","tags":["orthogonalization","muon_family","distributed","low_rank"]}
