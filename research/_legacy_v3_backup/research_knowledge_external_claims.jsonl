{"claim_id":"clm_r2_paramff_looped_vs_nonrecursive_landscape_2","claim_type":"causal","extracted_at":"2026-07-19","fingerprint":"70e774fbde7a51f5","limitations":["guarantees hold under the paper's landscape assumptions"],"locator":"results","paper_id":"pap_r2_paramff_looped_vs_nonrecursive_landscape","scope":{"claim":"convergence + complex-pattern learning"},"statement":"This landscape-level inductive bias provably yields better loss convergence along the river via valley-hopping and encourages learning more complex patterns than the standard-transformer landscape.","tags":["convergence","generalization","valley_hopping"]}
{"claim_id":"clm_r2_paramff_looped_vs_nonrecursive_landscape_3","claim_type":"descriptive","extracted_at":"2026-07-19","fingerprint":"e06a284c40d354b0","limitations":["evaluated on reasoning/algorithmic tasks"],"locator":"abstract","paper_id":"pap_r2_paramff_looped_vs_nonrecursive_landscape","scope":{"phenomenon":"length generalization"},"statement":"Standard non-recursive transformers exhibit a performance plateau on complex problems, notably degrading on sequences longer than seen in training, a length-generalization failure looped models mitigate.","tags":["length_generalization","reasoning"]}
