{"claim_id":"clm_opt_matrix_psgd_3","claim_type":"method_definition","extracted_at":"2026-07-19","fingerprint":"a0dfb3f6d85f8414","limitations":["structured forms trade accuracy for scalability"],"locator":"method","paper_id":"pap_opt_matrix_psgd","scope":{"algorithm":"psgd","preconditioner_structure":"dense_sparse_kronecker"},"statement":"PSGD supports structured preconditioners including dense, sparse, and Kronecker-factored forms, letting the preconditioner cost be traded off against approximation quality for large parameter matrices.","tags":["kronecker_factorization","structured_preconditioner","scalability"]}
