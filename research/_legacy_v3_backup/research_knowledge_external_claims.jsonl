{"claim_id":"clm_r2_speed_scaling_law_lr_annealing_3","claim_type":"descriptive","extracted_at":"2026-07-19","fingerprint":"73c408bda26962c5","limitations":["directional guidance; validated at small-to-mid scale"],"locator":"results","paper_id":"pap_r2_speed_scaling_law_lr_annealing","scope":{"use":"schedule comparison/optimization"},"statement":"The law makes explicit that the LR-annealing (decay) phase drives a sharp additional loss drop, enabling practitioners to compare and optimize schedules (e.g. WSD vs cosine) without running them in full.","tags":["schedule_comparison","annealing"]}
