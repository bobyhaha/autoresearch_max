{"claim_id":"clm_r2_paramff_intra_layer_recurrence_2","claim_type":"causal","extracted_at":"2026-07-19","fingerprint":"8c99f4487c03d14e","limitations":["shown on small-scale LM experiments","optimal allocation may shift with scale"],"locator":"results","paper_id":"pap_r2_paramff_intra_layer_recurrence","scope":{"finding":"earlier-layer iterations optimal"},"statement":"Allocating more recurrence iterations to earlier layers yields better language-modeling loss than distributing iterations to later layers or uniformly.","tags":["depth_allocation","recurrence_schedule"]}
