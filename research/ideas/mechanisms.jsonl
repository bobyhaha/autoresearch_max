# Versioned MechanismRecord objects.
{"mechanism_id": "mech_fused_ngram_hash_launch_overhead", "version": 1, "description": "The per-order, per-shift torch.zeros allocation + slice-assign in ngram_hash_ids launches many tiny CUDA kernels every step; fusing the construction (pad-based, byte-identical) should reduce launch count and raise steps/300s without changing model numerics.", "origin_type": "self_proposed", "claim_ids": [], "observation_ids": ["evd_obs_ngram_kernel_profile"], "causal_chain": ["ngram_hash_ids loops per order (2) and per shift-position (0..order-1), each allocating a fresh torch.zeros(B,T) and a slice-assign", "these small elementwise/index ops are individually cheap but launch-bound (measured: ~194k tiny fill/int kernels in nsys profile)", "fusing the construction into fewer ops should cut kernel-launch count", "fewer launches -> lower wall-clock per step -> more steps complete in the fixed 300s budget -> lower val_bpb via q*U"], "assumptions": ["the ~194k fill kernels are dominated by this specific construction path", "torch.compile does not already fully fuse the eager loop"], "competing_mechanism_ids": [], "scope": {"applies_to": "ngram_value_embedding_construction", "domain": "transformer_lm_pretraining"}, "observable_predictions": [{"observable_id": "obs_val_loss", "version": 1, "window": {"type": "full_training_run", "steps": 0}, "expected_pattern": {"type": "finite_and_decreasing"}}], "intervention_predictions": [{"intervention_id": "int_fused_ngram_hash_b1", "expected_change": "decrease step_time_ms (informally profiled) and, via more steps in the fixed 300s budget, decrease endpoint val_loss/val_bpb"}], "name": "N-gram hash construction launch-overhead sink", "status": "active", "tags": ["throughput", "kernel"], "notes": "", "fingerprint": "088cdee561a58d89"}
{"mechanism_id": "mech_canon_local_composition", "version": 1, "description": "A zero-init causal depthwise conv added to the residual stream gives each position cheap learned access to a combination of its immediate predecessors' hidden states, a differentiable feature transform distinct from the discrete n-gram lookup memorizer; predicted to accelerate per-step convergence without adding addressable memorizing capacity (Allen-Zhu, Physics of LMs 4.1).", "origin_type": "literature", "claim_ids": ["clm_canon_1"], "observation_ids": [], "causal_chain": ["residual stream currently mixes tokens only through attention (windowed) and the n-gram lookup", "a zero-init depthwise conv is a strict no-op at step 0, so any deviation from baseline is learned", "if local hidden-state composition is useful signal the attention/n-gram paths under-provide, the conv should learn a beneficial transform and lower per-step loss"], "assumptions": ["the SSSL windowed attention + n-gram memory do not already saturate the local-composition niche this conv targets"], "competing_mechanism_ids": [], "scope": {"applies_to": "residual_stream_local_mixing", "domain": "transformer_lm_pretraining"}, "observable_predictions": [{"observable_id": "obs_val_loss", "version": 1, "window": {"type": "full_training_run", "steps": 0}, "expected_pattern": {"type": "finite_and_decreasing"}}], "intervention_predictions": [{"intervention_id": "int_canon_conv_a1", "expected_change": "decrease endpoint val_loss/val_bpb"}], "name": "Canon zero-init depthwise conv as local-composition prior", "status": "active", "tags": ["architecture", "canon"], "notes": "", "fingerprint": "358d8fddb31b6093"}
{"mechanism_id": "mech_ngram_backoff_rare_key_noise", "version": 1, "description": "The n-gram hash memory (paper 011) is a memorizer whose harm at low data is concentrated in low-count keys whose learned correction reflects shard-specific noise rather than generalizable statistics. Scaling each key's contribution by a monotone function of its observation count suppresses under-evidenced corrections while passing through well-supported ones, reducing overfitting harm specifically when data is scarce.", "origin_type": "self_proposed", "claim_ids": [], "observation_ids": ["evd_obs_ngram_memorizer_data_scaling"], "causal_chain": ["the n-gram memory is the sole carrier of the campaign's data-sensitivity (paper 011: off is flat range 0.004, on is range 0.118)", "at low data (5 shards, ~4 epochs) it HARMS by +0.086 because memorized per-key corrections encode shard-specific noise for keys seen only a handful of times", "gating each key's contribution by count/(count+kappa) suppresses low-count (noisy) corrections while leaving high-count (well-evidenced) corrections nearly untouched", "this should reduce the harm at low data while leaving the 10-shard operating point (where the memory already helps) close to neutral"], "assumptions": ["harm is concentrated in low-count keys specifically, not spread uniformly across the table", "an online running count (not an offline full-corpus prepass) is a sufficient proxy for key frequency within the 300s training window"], "competing_mechanism_ids": [], "scope": {"applies_to": "ngram_value_embedding_construction", "domain": "transformer_lm_pretraining"}, "observable_predictions": [{"observable_id": "obs_val_loss", "version": 1, "window": {"type": "full_training_run", "steps": 0}, "expected_pattern": {"type": "finite_and_decreasing"}}], "intervention_predictions": [{"intervention_id": "int_ngram_backoff_gate_c3", "expected_change": "decrease endpoint val_loss/val_bpb at low data (5 shards); near-neutral at the 10-shard operating point"}], "name": "Rare n-gram keys carry memorization noise; frequency gates it", "status": "active", "tags": ["data_efficiency", "memorization"], "notes": "", "fingerprint": "b67358d542bb01f5"}
{"mechanism_id": "mech_ngram_composite_coverage_capacity_tradeoff", "version": 1, "description": "A full hash table gives each of 2^21 keys an independent row (high capacity, high memorization risk at low data). A product code with C decorrelated sub-hashes into small codebooks reduces free parameters by ~(table_size/(C*subcode_size)) while nominally preserving addressing via combinatorial composite keys (subcode_size^C possible codes). Predicted to behave like the small-table (2^15) regime at low data while retaining more of the large-table (2^21) coverage at the operating point, IF the sub-hashes are sufficiently decorrelated.", "origin_type": "literature", "claim_ids": ["clm_engram_tensorizing"], "observation_ids": [], "causal_chain": ["the full 2^21 table is a memorizer whose harm at low data (paper 011) comes from many independent, under-evidenced rows", "a product code cuts free parameters by orders of magnitude while nominally preserving per-key distinguishability via combinatorial addressing", "if the two sub-hashes (derived from the same rolling-hash formula with different multipliers) are not actually independent, collision rates will exceed the theoretical combinatorial bound, degrading coverage at the operating point"], "assumptions": ["two decorrelated hash functions from the same underlying formula (different multiplier constants) are 'independent enough' for the combinatorial coverage argument to hold"], "competing_mechanism_ids": ["mech_ngram_backoff_rare_key_noise"], "scope": {"applies_to": "ngram_value_embedding_construction", "domain": "transformer_lm_pretraining"}, "observable_predictions": [{"observable_id": "obs_val_loss", "version": 1, "window": {"type": "full_training_run", "steps": 0}, "expected_pattern": {"type": "finite_and_decreasing"}}], "intervention_predictions": [{"intervention_id": "int_ngram_composite_codes_c2", "expected_change": "approach 2^15-table performance at 5 shards while staying within 0.002 of 2^21-table performance at 10 shards"}], "name": "Product-code n-gram memory trades capacity for coverage", "status": "active", "tags": ["data_efficiency", "memorization"], "notes": "", "fingerprint": "cfaffcd4772f816b"}
{"mechanism_id": "mech_attnres_depth_retrieval", "version": 1, "description": "Per Kimi K3 (clm_attnres_mechanism), a learned per-layer softmax retrieval over all preceding layer outputs is strictly more expressive than a fixed scalar mix (our existing resid_lambdas/x0_lambdas), and should let each layer draw on whichever prior representation is most useful rather than a hand-fixed blend.", "origin_type": "literature", "claim_ids": ["clm_attnres_mechanism"], "observation_ids": [], "causal_chain": ["existing resid_lambdas/x0_lambdas fix a 2-source scalar blend (current x, token embedding x0) uniformly across positions and independent of content", "AttnRes instead computes content-dependent softmax weights over ALL preceding layer outputs via a learned per-layer pseudo-query", "this should let each layer retrieve exactly the representation it needs rather than a fixed blend, IF the retrieval pattern can be learned within the available updates"], "assumptions": ["the retrieval pattern (queries + gate) can be learned usefully within ~1900 steps of a 300s budget -- an assumption directly challenged by H9 (paper 009), which predicts learn-from-scratch mechanisms fail at this budget"], "competing_mechanism_ids": [], "scope": {"applies_to": "residual_stream_depth_mixing", "domain": "transformer_lm_pretraining"}, "observable_predictions": [{"observable_id": "obs_val_loss", "version": 1, "window": {"type": "full_training_run", "steps": 0}, "expected_pattern": {"type": "finite_and_decreasing"}}], "intervention_predictions": [{"intervention_id": "int_attnres_full", "expected_change": "decrease endpoint val_loss/val_bpb IF the retrieval pattern is learnable within-budget; H9 predicts it may not be"}], "name": "Learned cross-layer retrieval replaces uniform residual accumulation", "status": "active", "tags": ["architecture", "residual_stream", "h9_test"], "notes": "", "fingerprint": "dc99cc5cda1481f2"}
{"mechanism_id": "mech_ngram_table_wd_shrinkage", "version": 1, "description": "Decoupled AdamW weight decay pulls every n-gram table row toward zero every step; only rows receiving gradient (i.e., observed that step) resist the pull. Frequent/consistent keys retain a large correction; rare keys decay toward zero. At the 10-shard operating point, where paper 011 shows the memory already helps (-0.029), this same shrinkage may remove signal from well-evidenced rows that are currently earning their keep, unlike at low data where paper 011/C3 show the memory harms.", "origin_type": "self_proposed", "claim_ids": [], "observation_ids": ["evd_obs_ngram_memorizer_data_scaling"], "causal_chain": ["the n-gram memory helps at 10 shards and harms at 5 shards (paper 011)", "decoupled WD shrinks ALL rows continuously, including the well-evidenced ones responsible for the 10-shard help", "at strong enough lambda, this can net-negative even at the operating point where the memory is otherwise beneficial"], "assumptions": ["lambda=0.2 may be too strong specifically at the 10-shard operating point, even if a weaker lambda or the 5-shard regime would show net benefit (as C3's premise test suggests for the family)"], "competing_mechanism_ids": ["mech_ngram_backoff_rare_key_noise"], "scope": {"applies_to": "ngram_value_embedding_construction", "domain": "transformer_lm_pretraining"}, "observable_predictions": [{"observable_id": "obs_val_loss", "version": 1, "window": {"type": "full_training_run", "steps": 0}, "expected_pattern": {"type": "finite_and_decreasing"}}], "intervention_predictions": [{"intervention_id": "int_ngram_table_wd", "expected_change": "decrease val_bpb at low data; may INCREASE val_bpb at the 10-shard operating point if lambda is too strong"}], "name": "Decoupled weight decay as continuous count-adaptive backoff", "status": "active", "tags": ["data_efficiency", "memorization"], "notes": "", "fingerprint": "7aa4946adfae59b7"}
{"mechanism_id": "mech_attnres_ngram_wd_interaction", "version": 1, "description": "AttnRes introduces a new, initially-noisy learned signal into the residual stream while it is still learning its retrieval pattern; n-gram table WD simultaneously destabilizes the memory's well-evidenced corrections at the operating point. Run together, these two sources of representational disruption may compound super-additively rather than simply summing, because the optimizer must simultaneously stabilize a new architectural component and counteract active shrinkage of an existing one within the same short budget.", "origin_type": "self_proposed", "claim_ids": [], "observation_ids": ["evd_obs_f5_factorial_interaction"], "causal_chain": ["AttnRes alone regresses val_bpb (+0.0219, partly confounded by a ~26% step-count reduction from added compute)", "n-gram table WD alone regresses val_bpb (+0.0272, removing helpful signal at the operating point)", "if independent, the combined harm should be approximately additive (+0.0491 predicted)", "observed combined harm is +0.0715, i.e. roughly +0.022 in excess of the additive prediction -- a real negative interaction, not just two harms stacking"], "assumptions": ["the single-seed screen is not definitive; the interaction sign and magnitude should be confirmed with multi-seed paired runs before being treated as established"], "competing_mechanism_ids": [], "scope": {"applies_to": "combined_architecture_and_regularization_change", "domain": "transformer_lm_pretraining"}, "observable_predictions": [], "intervention_predictions": [{"intervention_id": "int_attnres_plus_ngram_wd", "expected_change": "super-additive regression vs the sum of the two individual arms' deltas"}], "name": "Compounding instability from two simultaneous learn/shrink pressures", "status": "active", "tags": ["factorial", "interaction"], "notes": "", "fingerprint": "81196df5b22b241d"}
{"mechanism_id": "mech_cudagraph_launch_overhead_capture", "version": 1, "description": "The frozen frame overrides torch.compile's own coded default (max-autotune) down to max-autotune-no-cudagraphs specifically to free ~25GB of CUDA-graph private pools for larger n-gram tables (train.py:1796-1806 comment). Without graph capture, every kernel in the compiled region -- including the many small n-gram-VE-path ops the campaign profiled at ~194k tiny launches -- pays full per-kernel CPU dispatch/launch latency each step, since B1 already showed Inductor's own operator fusion inside the graph is not the residual gap (byte-identical fused hash construction was throughput-null). CUDA-graph replay is the standard systems fix for a launch-bound (not compute-bound or fusion-bound) workload: it replays an entire captured op sequence with a single launch. The code already has forward-looking mark_static_address plumbing (train.py:1957-1970) anticipating this path.", "origin_type": "self_proposed", "claim_ids": [], "observation_ids": ["evd_obs_ngram_kernel_profile"], "causal_chain": ["the profiled ~194k tiny kernels pay per-kernel CPU dispatch/launch latency because CUDA-graph capture is currently disabled (max-autotune-no-cudagraphs)", "B1 already falsified Inductor in-graph fusion as the fix, meaning the gap is launch-latency-bound, not fusion-bound, for whatever portion of the sink lives inside the compiled graph", "re-enabling CUDA-graph capture replays the entire captured op sequence with a single launch, eliminating per-kernel dispatch overhead for the in-graph portion of the sink", "any portion of the sink that runs EAGER (outside the compiled graph, e.g. the sparse optimizer step) is structurally untouched by this fix regardless of VRAM/table-mult tuning"], "assumptions": ["a material fraction of the profiled 194k-kernel sink lives inside the torch.compile-captured forward/backward graph (not solely in the admittedly-eager sparse optimizer step)", "the ~25GB CUDA-graph private-pool VRAM cost does not force an NGRAM_TABLE_MULT reduction that would confound a throughput win with a capacity loss"], "competing_mechanism_ids": ["mech_fused_ngram_hash_launch_overhead"], "scope": {"applies_to": "compiled_kernel_launch_overhead", "domain": "transformer_lm_pretraining_systems"}, "observable_predictions": [{"observable_id": "obs_val_loss", "version": 1, "window": {"type": "full_training_run", "steps": 0}, "expected_pattern": {"type": "finite_and_decreasing"}}], "intervention_predictions": [{"intervention_id": "int_fa3_cudagraphs", "expected_change": "increase steps/300s by capturing and replaying the compiled region as a single launch; if the sink is dominated by the eager sparse-optimizer step instead, expect a smaller-than-hoped or null throughput gain"}], "name": "CUDA-graph replay collapses per-kernel CPU launch/dispatch overhead", "status": "active", "tags": ["systems_kernel", "launch_overhead", "cudagraph"], "notes": "", "fingerprint": "f6a52a08fd094921"}
{"mechanism_id": "mech_ngram_sparse_optimizer_eager_gap", "version": 1, "description": "_ngram_sparse_rmsprop_step runs entirely eager (never enters torch.compile's graph) because torch.unique has data-dependent output shape, explicitly incompatible with the fullgraph=True convention (the code's own comment at train.py:1999-2002). Each distinct n-gram table parameter pays its own full eager chain (torch.unique, index_add_, index_select, sqrt, index_add_) separately every step. This is mechanistically distinct from, and structurally excluded from, any fix that operates inside the compiled graph (including CUDA-graph capture, mech_cudagraph_launch_overhead_capture) -- it is a previously-untested, code-confirmed candidate for a share of the profiled launch-overhead sink that B1's null result did not rule out.", "origin_type": "self_proposed", "claim_ids": [], "observation_ids": ["evd_obs_ngram_kernel_profile"], "causal_chain": ["each distinct n-gram table parameter triggers its own separate eager 5-op chain (unique/index_add/index_select/sqrt/index_add) in the optimizer step, once per table per step", "this eager region is structurally excluded from torch.compile's graph (data-dependent torch.unique shape) and therefore from any in-graph fusion or CUDA-graph replay fix", "offset-packing all tables into one combined index space collapses the per-table chain into one chain total, cutting the number of eager-launched ops from O(num_tables x 5) to O(5) per step while preserving exact per-row arithmetic (same unique rows, same summed gradients, offset-disjoint index spaces prevent cross-table contamination)"], "assumptions": ["the number of distinct n-gram table parameters in the current SOTA config is large enough that this per-table repetition is a material (not negligible) share of total step time", "offset-packing preserves exact numerics (no cross-table index collisions after offsetting)"], "competing_mechanism_ids": ["mech_fused_ngram_hash_launch_overhead", "mech_cudagraph_launch_overhead_capture"], "scope": {"applies_to": "sparse_gradient_optimizer_step", "domain": "transformer_lm_pretraining_systems"}, "observable_predictions": [{"observable_id": "obs_val_loss", "version": 1, "window": {"type": "full_training_run", "steps": 0}, "expected_pattern": {"type": "finite_and_decreasing"}}], "intervention_predictions": [{"intervention_id": "int_ngram_sparse_optimizer_batched", "expected_change": "increase steps/300s if this eager region is a material share of the sink, with numerics unchanged by construction (byte-identical post-step state)"}], "name": "Per-table eager sparse-optimizer step pays a repeated, uncompiled op-chain cost", "status": "proposed", "tags": ["systems_kernel", "ngram", "sparse_gradient"], "notes": "Intervention not yet implemented; a cheap nsys pre-check should confirm this region's share of the kernel count before committing implementation effort, per the campaign's B2-after-reprofile discipline.", "fingerprint": "419eb94f4fc4c14a"}
{"mechanism_id": "mech_ngram_regularizer_redundancy", "version": 1, "description": "C1 (decoupled weight decay on stored n-gram rows, mech_ngram_table_wd_shrinkage) and C3 (a forward-activation count-based backoff gate, mech_ngram_backoff_rare_key_noise) are two DIFFERENT implementation sites -- optimizer-step weight shrinkage versus forward-pass activation gating -- of the same diagnosed phenomenon: harm concentrated in low-count/high-magnitude rare n-gram keys whose learned correction is shard-specific noise. Because both suppress overlapping variance (a rare row gets both few counteracting gradient updates against WD's uniform pull AND a low count/(count+kappa) activation gate), stacking them should show diminishing, not compounding, returns -- the opposite-shaped interaction from cycle 5's AttnRes+C1(0.2) result, where two UNRELATED sources of representational disruption (a not-yet-converged new architecture component and an over-aggressive shrinkage force) competed destructively for the same short optimization budget.", "origin_type": "self_proposed", "claim_ids": [], "observation_ids": ["evd_obs_f5_factorial_interaction"], "causal_chain": ["C1 (weak lambda) and C3 (kappa=50) each independently and substantially improve val_bpb at 5 shards (run_c1sweep_wd002 -0.0954; run_c3_k50_data5_treatment -0.0214) by suppressing noise from the same class of under-evidenced n-gram keys", "because they target overlapping variance via two different mechanisms (weight-space shrinkage vs activation-space gating) rather than two unrelated capacities, the combined benefit should be less than the naive additive sum of their individual effects (redundant, sub-additive), not simply cumulative", "this predicts the OPPOSITE interaction shape from the AttnRes+C1(0.2) factorial (paper 013), which found a super-additive-NEGATIVE interaction between two unrelated, individually-fragile mechanisms competing for the same short budget", "if the redundancy hypothesis is correct, the combined arm should still beat either single lever alone (both push in the same helpful direction) but by less than their sum -- distinguishing this from both pure independence (additive) and destructive interaction (worse than either alone)"], "assumptions": ["the two mechanisms' 'overlap' in which rows they affect is real and not merely a superficial similarity in stated motivation", "the already-measured individual 5-shard effects (C1 weak, C3 kappa=50) remain representative baselines for computing the additive-prediction comparison point"], "competing_mechanism_ids": ["mech_attnres_ngram_wd_interaction"], "scope": {"applies_to": "ngram_value_embedding_construction", "domain": "transformer_lm_pretraining"}, "observable_predictions": [{"observable_id": "obs_val_loss", "version": 1, "window": {"type": "full_training_run", "steps": 0}, "expected_pattern": {"type": "finite_and_decreasing"}}], "intervention_predictions": [{"intervention_id": "int_ngram_wd_c3_combo", "expected_change": "combined val_bpb delta at 5 shards beats either single lever alone but is measurably less negative than their naive additive sum; near-neutral at the 10-shard operating point, tracking whichever component (if either) shows a 10-shard effect"}], "name": "Two implementation sites of the same rare-key-noise suppression compose sub-additively", "status": "active", "tags": ["data_efficiency", "memorization", "factorial", "interaction"], "notes": "Deliberately designed as a generalization test of paper 013's negative-interaction finding: this predicts a DIFFERENT interaction shape (sub-additive/redundant, not super-additive/destructive) because the two components share a common target rather than being unrelated.", "fingerprint": "d999a9c9c90a41af"}
{"mechanism_id": "mech_mhc_lite_writeback", "version": 1, "description": "x0 (train.py:1397, norm(wte(idx))) is assigned once and never updated -- every layer only READS from it via an unconstrained 2-scalar affine gate (resid_lambdas/x0_lambdas). This is a one-way tap, not a co-evolving residual stream in the Hyper-Connections sense (clm_hc_identity_mapping_instability): plain Hyper-Connections expand a single stream into n parallel, mutually-updating streams with learned dynamic mixing, but plain (unconstrained) mixing matrices break the residual identity-mapping property and cause training instability at scale (clm_hc_identity_mapping_instability), which the DeepSeek-V4 mHC paper fixes via a manifold projection restoring identity mapping (clm_mhc_manifold_projection_fix). This mechanism operationalizes a minimal version: after each block computes its output, write a per-layer-learned, softmax-row-normalized (a point on the Birkhoff/doubly-stochastic manifold -- literally 'manifold-constrained') fraction of it back into x0 as well as x, giving x0 a genuine second life while directly instantiating the manifold-constraint mechanism the literature attributes the stability fix to.", "origin_type": "literature", "claim_ids": ["clm_hc_identity_mapping_instability", "clm_mhc_manifold_projection_fix"], "observation_ids": [], "causal_chain": ["x0 currently only ever gets READ (via resid_lambdas/x0_lambdas), never written after its single initial assignment, so it cannot carry forward any depth-dependent refinement the way a true multi-stream residual would", "adding a learned write-back turns x0 into a genuine second residual stream, giving the network additional representational routing capacity between the two streams", "constraining the write matrix's rows to be softmax-normalized (summing to 1, a point on the Birkhoff/doubly-stochastic manifold) is the specific mechanism the mHC literature attributes the stability advantage to over an unconstrained Hyper-Connections write, by preserving a form of the residual identity-mapping property", "zero/large-negative-logit initialization of the write gate makes the mechanism an exact no-op at step 0, so any measured effect is attributable to what the network learns to do with the new write path, not to a change in the initial function computed"], "assumptions": ["the extra ~16 scalar write-matrix parameters (2x2 per layer x 8 layers) can be usefully learned within ~1900 steps of a 300s budget", "the residual-stream-addition family's mixed-to-harmful local track record (AttnRes held/confounded, A1 Canon decisively rejected) does not automatically extend to this structurally different (manifold-constrained multi-stream) mechanism"], "competing_mechanism_ids": ["mech_attnres_depth_retrieval", "mech_canon_local_composition"], "scope": {"applies_to": "residual_stream_depth_mixing", "domain": "transformer_lm_pretraining"}, "observable_predictions": [{"observable_id": "obs_val_loss", "version": 1, "window": {"type": "full_training_run", "steps": 0}, "expected_pattern": {"type": "finite_and_decreasing"}}], "intervention_predictions": [{"intervention_id": "int_mhc_lite_writeback", "expected_change": "decrease val_bpb at the 10-shard operating point if the constrained write-back is learnable within budget; plausible null given the residual-stream-addition family's mixed local track record"}], "name": "A learned, manifold-constrained write-back gives the frozen x0 stream genuine two-stream residual routing", "status": "proposed", "tags": ["architecture", "residual_stream", "mhc", "explore"], "notes": "Intervention not yet implemented. First local mechanism directly operationalizing the mHC literature claims (clm_hc_identity_mapping_instability, clm_mhc_manifold_projection_fix); scoped deliberately as a minimal pilot per evd_lit_mhc_candidate_scope's explicit recommendation, not a full multi-stream commitment.", "fingerprint": "c72fc2f9595b4769"}
{"assumptions":["the affine throughput model t_step = 15.0 + 1.875*B holds; measured within 0.3-3.6% on every uncontended arm against a 15% falsifier","gradient accumulation is pinned to 1 so that tokens per optimizer step equals the device batch exactly","the training corpus is frozen at 10 shards and the run sits near the 2-epoch boundary, so token gains beyond ~1.4x cannot be spent without entering the measured epoch-3 collapse (val_bpb 0.987)","contended arms are excluded on a step-count and MFU signature; 3 arms were quarantined on this basis"],"campaign_batch_ids":["cmp_block18_direct_ssh","cmp_block19_direct_ssh","cmp_block20_direct_ssh"],"causal_chain":["a fixed 300s wall-clock budget converts every mechanism's step-time cost into a token-count cost, so the frame scores the PRODUCT of intrinsic quality and throughput rather than either alone","at fixed batch, tokens = steps * (batch * seqlen) is proportional to steps, so a token law and a step law are observationally identical and no number of seeds can separate them","varying batch decouples them: smaller batch buys optimizer steps but loses MFU and therefore tokens; larger batch buys tokens but loses optimizer steps","below the optimum the token loss dominates (B=48 and B=32 regress by +0.0033/+0.0060 and +0.0109/+0.0087 despite up to 1.94x more steps)","above the optimum the step loss dominates and cancels the token gain exactly (B=96 delivers +3.5% to +9.0% more tokens for a mean delta of -0.000406, t=-0.37)","the residual of a lever against the fixed-batch token-law prediction isolates its INTRINSIC quality effect, measured at approximately -0.0007 for n-gram capacity","since intrinsic effects are ~1e-3 and throughput effects are ~1e-2, break-even for a mechanism costing s step time is 0.06*(-ln(1-s)), so any mechanism costing more than ~1.5% step time cannot break even"],"claim_ids":[],"competing_mechanism_ids":[],"description":"Under a wall-clock budget, endpoint val_bpb is governed by TOTAL TOKENS PROCESSED rather than by optimizer step count, but only at FIXED BATCH SIZE, where tokens are exactly proportional to steps. Across batch changes the two decouple with opposite signs and a single-variable token law fails, leaving an interior optimum. Fitted form val_bpb = a - b*ln(tokens) with b in [0.046, 0.086] (4 pairwise estimates, 2 seed series). Validated out of sample: fit on a batch ladder, it predicted an n-gram table-size sweep's 5 deltas with residuals -0.00008 to -0.00160, all at fixed batch B=72. Scoping established by a paired n=5 B=96 test in which the treatment processed MORE tokens in all 5 pairs (+3.5% to +9.0%) while residuals were POSITIVE in all 5 (+0.0008 to +0.0048): the extra tokens arrive and the quality does not.","fingerprint":"f3f8a098f4a266c6","intervention_predictions":[],"mechanism_id":"mech_token_throughput_law_fixed_batch","name":"val_bpb tracks total tokens, not optimizer steps -- but only at fixed batch size","notes":"Supersedes the step-count framing of paper 016, which was UNDER-DETERMINED rather than wrong: every supporting experiment held batch fixed. Two of our own claims were retracted in establishing this: (1) 'B=72 is optimal because it is the MFU peak' -- right conclusion, wrong reason, and it rested on a contaminated arm; (2) 'tok/s is monotone in B so B=288 clears the gate on throughput alone' -- falsified at paired n=5. See AI_papers/paper_017_tokens_not_steps_20260729.tex.","observable_predictions":[],"observation_ids":[],"origin_type":"internal_experiment","scope":{"applies_to":"walltime_budgeted_training_throughput","domain":"transformer_lm_pretraining"},"status":"active","tags":["systems_kernel","throughput","batch_size","scoping","internal_experiment"],"version":1}
{"assumptions":["the intervention under test does not itself change throughput; otherwise the correction removes real signal along with noise and the decomposition is not identified","the fixed-batch token law holds at the operating point, which requires batch size held constant across the paired arms","b is known only to within [0.046, 0.086], so the correction carries coefficient uncertainty that is not propagated in the current estimate","residual contention effects that do not act through step count (for example memory-bandwidth interference at equal step count) are not removed"],"campaign_batch_ids":["cmp_block21_direct_ssh","cmp_block22_direct_ssh"],"causal_chain":["a co-tenant on the shared 8xH200 box steals SM time, lowering MFU and therefore the step count an arm completes in the fixed 300s budget","at fixed batch, tokens processed is exactly step count times batch times sequence length, so a step-count perturbation is a token perturbation","the fixed-batch token law converts a token perturbation into a predicted val_bpb perturbation with coefficient b~0.06","subtracting that predicted component from each paired delta removes the contention-induced variance while leaving the intervention's intrinsic effect intact","the residual variance is what remains after the dominant known nuisance path is removed, so the estimator is more sensitive at equal seed count"],"claim_ids":[],"competing_mechanism_ids":["mech_token_throughput_law_fixed_batch"],"description":"On a shared GPU box, co-tenant contention perturbs step count, step count determines tokens, and tokens determine val_bpb through the measured fixed-batch law val_bpb = a - b*ln(tokens), b~0.06. That path is PREDICTABLE, so contention noise can be SUBTRACTED as a control variate rather than averaged away with more seeds. Applying it to a lever that provably cannot affect throughput (host-side scalar arithmetic) cut the paired-delta standard deviation 6.5x, from 0.001469 to 0.000226, and moved 5/6 same-sign to 6/6 (t from -2.53 to -6.51).","fingerprint":"fca1f272bd1ed55b","intervention_predictions":[],"mechanism_id":"mech_token_law_as_control_variate","name":"The token law doubles as a control variate that removes contention noise from paired deltas","notes":"Recorded single-seed noise floor is sigma=0.00061, 72% of the 0.004072 gate -- the reason n=1 has never resolved sub-gate levers and the direct cause of two misreads this session (the B=96 seed-43 arm and the s45 pair). At sd=0.000226 the standard error at n=3 is 0.00013. IMPLICATION TO TEST: several of this session's nine nulls may be real effects buried under contention noise; re-analysis under the control variate is the proposed next block. NOT yet validated on an intervention with a genuine throughput component, which is its main open risk.","observable_predictions":[],"observation_ids":[],"origin_type":"internal_experiment","scope":{"applies_to":"paired_experiment_variance_reduction_on_shared_hardware","domain":"transformer_lm_pretraining"},"status":"proposed","tags":["methodology","variance_reduction","contention","shared_cluster","internal_experiment"],"version":1}
{"assumptions":["BOS tokens reliably delimit documents in every training batch","the FA3 varlen wrapper preserves the same within-document causal/window envelope as the dense reference","the reported paired measurements remain provisional because they bypassed the gated-run ledger"],"campaign_batch_ids":["cmp_block15_direct_ssh_b","cmp_block16_direct_ssh","cmp_block17_direct_ssh"],"causal_chain":["BOS boundaries define a block-diagonal causal attention graph within each flattened batch","cu_seqlens passes those boundaries to the FA3 varlen kernel without materializing a BxTxT mask","the kernel omits cross-document blocks, preserving document isolation while reducing attention work"],"claim_ids":[],"competing_mechanism_ids":[],"description":"Packing each document as a variable-length FA3 sequence makes document boundaries part of the kernel schedule. Cross-document attention blocks are skipped rather than computed and then masked, so the intervention can improve both document isolation and wall-clock throughput.","fingerprint":"ae6e6caf3f9c0368","intervention_predictions":[{"expected_change":"lower val_bpb without the SDPA/dense-mask throughput penalty","intervention_id":"int_doc_mask_seg"}],"mechanism_id":"mech_fa3_varlen_document_isolation","name":"FA3 varlen document boundaries remove cross-document attention without a dense mask","notes":"The implementation is the current wall-time default, but its historical n=10 adoption remains provisional in the structured state until reproduced through authorize-run with immutable RunRecords.","observable_predictions":[{"expected_pattern":{"type":"finite_and_decreasing"},"observable_id":"obs_val_loss","version":1,"window":{"steps":0,"type":"full_training_run"}}],"observation_ids":[],"origin_type":"internal_experiment","scope":{"applies_to":"fa3_varlen_document_masking","domain":"transformer_lm_pretraining"},"status":"active","tags":["attention","document_mask","fa3","internal_experiment"],"version":1}
{"assumptions":["The v29 changes are post-clock/exposure attestation only and do not alter model, optimizer, schedule, data order, evaluator, or FA3 inputs.","The four preserved treatment logs and derived exact token counts are correctly bound by their immutable SHA-256 values.","The six changed recipe coordinates act as one system during qualification; no component-level attribution is licensed.","Four pairs provide a strict falsification screen but limited equivalence power; a miss is qualification failure or indeterminacy, not proof of population nonequivalence."],"campaign_batch_ids":["cmp_block21_direct_ssh"],"causal_chain":["The smaller recovered batch shape increases optimizer-update exposure inside the unchanged 300-second clock while the token-fidelity gate prevents a simple extra-token explanation.","TTTL attention and its coupled matrix-LR, warmdown, and momentum settings change where representation and optimization capacity are spent over those additional updates.","If the coupled trajectory transfers to the instrumented current source, the recovered arm lowers raw endpoint BPB versus the explicit incumbent.","Historical-anchor equivalence and concurrent superiority must both hold before the recipe can enter a fresh confirmation funnel."],"claim_ids":[],"competing_mechanism_ids":[],"description":"The recovered recipe couples smaller device/global batches, TTTL attention allocation, a higher matrix learning rate, shorter warmdown, and continuous Muon momentum. On current source this can trade similar token exposure for more optimizer updates and a different short-horizon trajectory. Same-seed concurrent comparison estimates the whole-bundle effect; same-seed historical anchors separately test transport fidelity.","fingerprint":"948432d256cad01c","intervention_predictions":[{"expected_change":"mean endpoint BPB decreases by about 0.0068785 versus the explicit current recipe while historical-recipe token exposure stays within the preregistered equivalence band","intervention_id":"int_block22_legacy_recipe_transport"}],"mechanism_id":"mech_block22_legacy_recipe_control_transport","name":"Coupled recipe transport changes finite-budget update allocation","notes":"Preregistered in canonical paper_022_dual_anchor_control_transport. Historical rows remain quarantined prediction priors.","observable_predictions":[],"observation_ids":[],"origin_type":"internal_experiment","scope":{"applies_to":"walltime_5min_h200_current_source_control_transport","decision_frame":"walltime_5min_h200","domain":"transformer_lm_pretraining"},"status":"active","tags":["block22","control_transport","training_recipe","internal_experiment"],"version":1}
{"assumptions":["Packer starts and scanner-detected interior BOS positions are exactly equivalent over 1000 independent packed batches.","Pinned source lifetime and CUDA producer/consumer event ordering remain valid through FA3 backward on the target H200.","The sidecar-off generator allocates no sidecar buffers, streams, events, or leases and preserves the legacy triple.","Variable boundary counts retain exactly one compiled graph after warmup.","A 20-step semantic/state scanner/scanner prefix precedes a 20-step scanner/sidecar phase, a 10-step washout, and exactly 200 clean samples.","A single physical placement cannot authorize an endpoint; a threshold pass requires a separately preregistered role-swapped profile."],"causal_chain":["The local best-fit packer identifies literal document starts while placing tokens.","The scanner path reconstructs the same starts from each packed CUDA batch inside the charged step.","The sidecar stages the packer-known int32 cumulative offsets and supplies them through the same FA3 varlen API.","Exact inputs, targets, order, segments, compiled graph, parameters, and optimizer state are preserved while charged boundary work decreases.","If isolated-H200 token throughput clears robust break-even, the fixed 300-second recipe completes more useful updates and lowers endpoint validation BPB."],"claim_ids":["clm_fa3_varlen_external_cuseqlens_contract"],"competing_mechanism_ids":[],"description":"The best-fit packer already knows every document start while it constructs each packed row. Transporting those immutable int32 offsets through a pinned-memory/event-governed sidecar can replace the charged CUDA BOS scan and cumulative-offset reconstruction while preserving the exact FA3 varlen segmentation.","fingerprint":"79759a467ccbb90d","intervention_predictions":[{"expected_change":"token-rate ratio point estimate >=1.054 and one-sided 95% lower confidence bound >=1.041, conditional on exact parity","intervention_id":"int_paper019_fa3_boundary_sidecar_treatment"}],"mechanism_id":"mech_paper019_fa3_boundary_sidecar","name":"Packer-known boundaries remove redundant FA3 offset reconstruction","notes":"External provenance is limited to clm_fa3_varlen_external_cuseqlens_contract: the official pinned FA3 code accepts and reuses CUDA int32 cumulative offsets. The packer-side generator, ring/event lifetime, exact local parity, throughput, and BPB effect are local extrapolations. The mixed MechanismRecord schema permits no observation_ids; static code inspection is not misrepresented as a run-derived ObservationRecord.","observable_predictions":[],"observation_ids":[],"origin_type":"mixed","scope":{"attention_backend":"fa3_varlen","decision_frame":"walltime_5min_h200","domain":"transformer_lm_pretraining","hardware":"H200","local_extrapolation":"packer-side generation, asynchronous transport, and local throughput/BPB effects are not established by the external claim","training_recipe":"complete_recovered_experiment_501_recipe"},"status":"proposed","tags":["paper019","round1","fa3","boundary_sidecar","systems_kernel","mixed_provenance"],"version":1}
{"assumptions": ["The sparse path's forward is numerically identical to nn.Embedding (a pure row gather).", "Row indices touched per step are a negligible fraction of table rows, so sparse apply is cheaper.", "The custom_op boundary's blocked inductor epilogue fusion costs less than the fills it removes -- this is the assumption that killed six earlier proposals and is the main way this one can fail.", "The optimizer state update for n-gram tables (RMSProp) admits a row-subset update without changing the update semantics for untouched rows.", "The frame remains time-budgeted, so throughput converts to tokens rather than to wall-clock saved."], "causal_chain": ["The hashed n-gram value embeddings hold ~1.61e9 parameters across several registered hash sites.", "Each forward pass gathers at most B*T ~ 1.5e5 rows per site -- a ~1e-4 fraction of each table.", "Autograd's dense embedding backward allocates a gradient the full size of the table.", "That gradient must be zeroed before scatter-accumulation, emitted as many small fill kernels.", "Fill launches scale with TABLE size, not with TOUCHED-ROW count, so they dominate the kernel tail.", "The step becomes launch-overhead-bound: MFU ~19% while the block GEMMs individually run at ~90%.", "Capturing (row index, gradient) pairs instead and applying them sparsely removes the fill launches.", "Step time falls; under STOP_MODE=time the saved time is spent on more optimizer steps.", "More steps means more tokens, and the token law val_bpb = a - b*ln(tokens) converts tokens to bpb."], "claim_ids": ["clm_sparsetransx_spmm_mechanism"], "competing_mechanism_ids": [], "description": "OBSERVED PHENOMENON (evd_obs_ngram_kernel_profile): the training step runs at ~19% MFU and is launch-overhead-bound rather than compute-bound, with a long tail of ~194k tiny int/fill kernel launches concentrated in the n-gram value-embedding path. Attention (~5%) and cross-entropy (~1.6%) do not account for it, and paper 025/026 measured the block GEMMs themselves at ~90% MFU -- so the loss is OUTSIDE the matmuls.\n\nPROPOSED CAUSE: autograd's dense embedding backward allocates a gradient tensor the shape of the ENTIRE embedding table and zero-fills it, then scatter-accumulates into the touched rows. The hashed n-gram value embeddings hold ~1.61e9 parameters across several hash sites -- 95% of the model's real parameter count -- while a single step touches at most B*T ~ 1.5e5 distinct rows per site. The zero-fill therefore writes many orders of magnitude more bytes than the gradient needs, and because it is emitted as a large number of small tiled fill launches rather than one big memset, it converts into LAUNCH COUNT, which is what the profile actually shows. The phenomenon is a fill flood, not a FLOP deficit.", "fingerprint": "2ece47168d4023e4", "intervention_predictions": [{"expected_change": "RAW paired val_bpb decrease of ~0.0058 (= -0.06*ln(1.102)), i.e. ~2.4x the 0.002396 gate, arising ENTIRELY through the token law. The INTRINSIC (throughput-corrected) delta should be ~0 -- the mechanism is a throughput mechanism and claims no per-token quality change.", "intervention_id": "int_ngram_sparse_grad_treatment"}], "mechanism_id": "mech_ngram_dense_embedding_backward_fill_flood", "name": "Dense embedding backward zero-fills the whole hash table per site per step", "notes": "DISCRIMINATING PREDICTION -- this is what makes the mechanism falsifiable rather than a restatement of the speedup. The fill-flood account says the wasted work scales with TABLE ROWS and is independent of batch size. A rival account -- 'the n-gram path is simply memory-bandwidth bound on the gathers' -- says the cost scales with TOUCHED ROWS, i.e. with B*T. These differ sharply under NGRAM_TABLE_MULT: the fill-flood account predicts the sparse-grad speedup GROWS with table multiplier, the bandwidth account predicts it is flat. E6 runs at the frame default; if E6 clears the gate, the multiplier sweep is the mechanism test and is the designated follow-up.\n\nPROVENANCE HONESTY: the external claim clm_sparsetransx_spmm_mechanism is recorded in the corpus as evidence_class=paper_faithful_scope_mismatch, and its own limitations field states that 'only a measured local sparse gather/scatter bottleneck could justify a derived test'. That precondition was registered BEFORE the profile existed and is now satisfied by evd_obs_ngram_kernel_profile. This mechanism is therefore locally grounded with an external form, not an external result imported across a scope gap.\n\nE7 OUTCOME (block29): the discriminating prediction is CONFIRMED. Sparse-gradient penalty in median step time fell from +19.4 ms (+12.95%) at mult=64 to +6.0 ms (+3.22%) at mult=256 -- a 3.2x reduction against a 4x table growth. The rival bandwidth account, which requires the penalty to be flat in table size, is CONTRADICTED. This is the campaign's first mechanism whose prediction was registered before the discriminating data existed and then held. WHAT IT DOES NOT BUY: mult=256 costs +0.010883 val_bpb versus mult=64, 4.2x the gate, so the regime where the fill flood dominates is a regime the frame cannot afford. The mechanism is supported AND the intervention derived from it is closed. Those are separate findings and are recorded separately on purpose.", "observable_predictions": [{"expected_pattern": "Median step time falls; the prior clean A/B measured -9.3%. A fill-flood cause predicts the saving scales with TABLE size, not batch size.", "observable_id": "obs_step_time_ms"}, {"expected_pattern": "Under a fixed 300s budget, tokens/sec and hence completed steps rise by roughly the reciprocal of the step-time ratio, i.e. ~+10.2% if -9.3% holds.", "observable_id": "obs_tok_per_sec_k"}], "observation_ids": ["evd_obs_ngram_kernel_profile"], "origin_type": "mixed", "scope": {"attention_backend": "fa3", "decision_frame": "walltime_5min_h200", "domain": "transformer_lm_pretraining", "hardware": "H200", "local_extrapolation": "The external SparseTransX claim is knowledge-graph embedding training and is scope-mismatched by its own limitations field; it supplies the mechanism form only. The quantitative prediction here rests on the LOCAL nsys observation evd_obs_ngram_kernel_profile, not on any transferred external number.", "training_recipe": "frozen_walltime_5min_h200_ten_shard"}, "status": "active", "tags": ["e6", "throughput", "ngram", "sparse_grad", "launch_bound", "pytorch_142315", "block27"], "version": 2}
{"assumptions": ["The corpus stays frozen; it is part of the scope key, so 'add unique data' is out of frame.", "torch.compile already captures the easy throughput wins, so most throughput proposals are no-ops.", "The 1e-3 intrinsic scale is a property of this model size and budget, not a universal constant.", "SELF-SERVING RISK, recorded deliberately: this mechanism explains a campaign of nulls, which is also what I would say if I had simply searched a saturated frame for too long. It earns its status from the prospective empty-cell prediction below, not from its explanatory tidiness."], "causal_chain": ["STOP_MODE=time fixes wall clock, so tokens consumed = throughput x 300s, not a free design choice.", "val_bpb follows a - b*ln(tokens) with b ~ 0.06 over the unsaturated range, so tokens dominate.", "The corpus is frozen at ~250M unique tokens, so more tokens means more PASSES, not more data.", "Past ~2.3 passes repetition inverts the token law and costs 16-18 gates.", "The achievable region is therefore bounded above by throughput and below by the cliff.", "Any intervention that does not move tokens can only act through the ~1e-3 intrinsic channel.", "The baseline sits at 1.9 passes, just under the cliff, hence locally optimal on every feasible axis."], "claim_ids": [], "competing_mechanism_ids": [], "description": "Under a fixed wall-clock budget the frame has essentially one free parameter -- how many tokens the budget buys before the data-repetition cliff. Intrinsic (non-throughput) refinements move val_bpb by ~1e-3 against a 2.6e-3 floor; throughput levers move it by ~1e-2 but run into the cliff. The frozen baseline already sits just under the cliff, so local search reports zero gradient in every feasible direction and a cliff in the one direction with headroom. This single structure accounts for all 31 closed directions.", "fingerprint": "55d5e221eca48c92", "intervention_predictions": [{"expected_change": "PROSPECTIVE AND CONFIRMED. The campaign's own grid had an empty cell at 1.5-2.0 passes; a configuration placed there should beat the baseline while every other shape overshot the cliff. It did: -0.002431 at n=97. The prediction came from noticing the empty cell, before the run -- not from a new idea about training.", "intervention_id": "int_depth6_dim640"}, {"expected_change": "REFUTABLE, UNTESTED. With a 3x larger corpus the token law should hold with b~0.06 out to at least 2x the current budget and the cliff should not appear. This is the cleanest single test of the whole mechanism, and it requires a new frame.", "intervention_id": "int_unfrozen_corpus_3x"}], "mechanism_id": "mech_frame_token_saturation_boundary_optimum", "name": "The frame is token-saturated and its optimum is a boundary optimum", "notes": "", "observable_predictions": [{"expected_pattern": "Throughput is the dominant axis: an intervention that leaves tok/s unchanged cannot move val_bpb by more than the ~1.3e-3 intrinsic band, alone or stacked. Interventions that raise tok/s move it by ~1e-2 -- in either sign, depending on which side of the cliff they land.", "observable_id": "obs_tok_per_sec_k"}, {"expected_pattern": "Plotted against ln(tokens), endpoints fall on the token law until ~2.3 passes and then invert. The best reachable point is the largest token count still below that inversion.", "observable_id": "obs_val_loss"}], "observation_ids": [], "origin_type": "self_proposed", "scope": {"attention_backend": "fa3", "decision_frame": "walltime_5min_h200", "domain": "transformer_lm_pretraining", "hardware": "H200", "local_extrapolation": "Derived from this campaign's own paired measurements on the compiled production path. No external number is transferred; external sources supply mechanism form only.", "training_recipe": "frozen_walltime_5min_h200_ten_shard"}, "status": "active", "tags": [], "version": 1}
{"assumptions": ["Row-group shuffling changes visit order without changing the multiset of tokens seen.", "One shuffle draw is representative. A second draw was NOT run; this is the weakest link in the chain."], "causal_chain": ["Ten shards are consumed in a fixed order, so pass index and corpus position advance together.", "A degradation at high token counts is therefore attributable to either repetition or corpus region.", "Shuffling row-group order breaks the confound while holding token count and pass count fixed.", "A corpus-region cause predicts a large endpoint move under reordering; repetition predicts a small one.", "Reordering at depth 5 moved the endpoint by 0.0022 -- 4.7% of the 0.0464 cliff.", "Preregistered thresholds were <0.003 for repetition and >0.01 for corpus region. Repetition."], "claim_ids": [], "competing_mechanism_ids": [], "description": "val_bpb collapses by 16-18 gates once training passes ~2.3 times over the frozen shards. Because shard order was fixed, 'the third pass' and 'the tail of the corpus seen a third time' were perfectly confounded in every prior run. Shuffling row-group order discriminates them, and the answer is repetition.", "fingerprint": "a1dd75bdf0b7a55b", "intervention_predictions": [{"expected_change": "CONFIRMED. Row-group shuffle at depth 5 moved the endpoint 0.0022, inside the preregistered repetition threshold and far below the corpus-region threshold.", "intervention_id": "int_shuffle_data"}, {"expected_change": "REFUTABLE, UNTESTED, HIGHEST VALUE. Raising unique-token count while holding passes fixed should remove the cliff entirely. If the cliff reappears at the same PASS count on a larger corpus, this mechanism is refuted and the shuffle draw was unrepresentative.", "intervention_id": "int_unfrozen_corpus_3x"}], "mechanism_id": "mech_data_repetition_cliff", "name": "The cliff is repetition, not corpus region", "notes": "", "observable_predictions": [{"expected_pattern": "The cliff appears at the same PASS count across shapes spanning 39.8M-94.4M dense parameters: 2.3, 2.5, 2.7 passes land at 0.987, 0.973, 0.978 while 1.9 passes lands at 0.9295. Shape-independence is what makes this a data property rather than a model property.", "observable_id": "obs_val_loss"}, {"expected_pattern": "Above the cliff the gap widens sharply while train loss keeps falling -- the signature of repetition being memorised rather than of a harder corpus region.", "observable_id": "obs_train_val_gap"}], "observation_ids": [], "origin_type": "self_proposed", "scope": {"attention_backend": "fa3", "decision_frame": "walltime_5min_h200", "domain": "transformer_lm_pretraining", "hardware": "H200", "local_extrapolation": "Derived from this campaign's own paired measurements on the compiled production path. No external number is transferred; external sources supply mechanism form only.", "training_recipe": "frozen_walltime_5min_h200_ten_shard"}, "status": "active", "tags": [], "version": 1}
{"assumptions": ["Hash-row count changes capacity without qualitatively changing collision statistics."], "causal_chain": ["Hash rows set the memorisation capacity of the dominant parameter block.", "Below the cliff the model is data-rich relative to capacity: cutting rows destroys usable statistics.", "Above the cliff it is repetition-bound: cutting rows removes capacity that was memorising repeats.", "Pass count and train/val gap co-vary in the default sweep, so they had to be separated.", "Varying depth changes the gap at fixed pass count; the sign followed the gap, not the passes."], "claim_ids": [], "competing_mechanism_ids": [], "description": "Cutting hash rows costs +0.0079 below the cliff and gains -0.0163 (6.2 gates) above it. Crossing depth separated the two candidate drivers: the flip follows the train/val gap, not the pass count. Capacity reduction helps exactly where the model overfits and nowhere else.", "fingerprint": "6211f816e51b700c", "intervention_predictions": [{"expected_change": "CONFIRMED across the depth crossing: reducing capacity helps only where the gap is already wide.", "intervention_id": "int_ngram_table_mult_128"}, {"expected_change": "CLOSED ON ECONOMICS. The lever only helps in configurations already 16-18 gates uncompetitive, so it has no reachable operating point -- the second such mechanism in this campaign, after fill-flood.", "intervention_id": "int_ngram_table_mult_256"}], "mechanism_id": "mech_capacity_lever_sign_tracks_train_val_gap", "name": "The n-gram capacity lever changes sign with the train/val gap, not with pass count", "notes": "", "observable_predictions": [{"expected_pattern": "The sign flip coincides with the gap crossing, not with the 2.3-pass mark.", "observable_id": "obs_train_val_gap"}, {"expected_pattern": "Halving hash rows costs +0.0079 below the cliff and gains -0.0163 above it.", "observable_id": "obs_val_loss"}], "observation_ids": [], "origin_type": "self_proposed", "scope": {"attention_backend": "fa3", "decision_frame": "walltime_5min_h200", "domain": "transformer_lm_pretraining", "hardware": "H200", "local_extrapolation": "Derived from this campaign's own paired measurements on the compiled production path. No external number is transferred; external sources supply mechanism form only.", "training_recipe": "frozen_walltime_5min_h200_ten_shard"}, "status": "active", "tags": [], "version": 1}
{"assumptions": ["The refinements as implemented are faithful to their sources -- verified separately."], "causal_chain": ["ASSERTED, now refuted: refinement benefits are cumulative in update count.", "ASSERTED: 2000 steps sits below the accrual threshold.", "TEST: depth 6 raises the step count 63% at identical wall clock, changing nothing else about the arm.", "RESULT: no refinement moved outside +/-1.3e-3. The premise fails."], "claim_ids": [], "competing_mechanism_ids": [], "description": "Paper 027's explanation of the null refinements: they 'accrue over many more updates than 2000'. Depth 6 supplies 3276 steps, 63% more, and all arms still landed within +/-1.3e-3, alone and stacked. RETRACTED, with a correction notice added to the original paper.", "fingerprint": "55b12017aa4abcad", "intervention_predictions": [{"expected_change": "REFUTED by direct test at 3276 steps.", "intervention_id": "int_depth6_dim640"}], "mechanism_id": "mech_refinement_null_from_duration", "name": "REFUTED: intrinsic refinements are null because 2000 steps is too few", "notes": "", "observable_predictions": [{"expected_pattern": "Step count rises from ~2010 to 3276, a 63% increase at identical wall clock.", "observable_id": "obs_progress"}, {"expected_pattern": "Refinement effect size should grow with that step count. It did not: every arm stayed inside +/-1.3e-3, alone and stacked.", "observable_id": "obs_val_loss"}], "observation_ids": [], "origin_type": "self_proposed", "scope": {"attention_backend": "fa3", "decision_frame": "walltime_5min_h200", "domain": "transformer_lm_pretraining", "hardware": "H200", "local_extrapolation": "Derived from this campaign's own paired measurements on the compiled production path. No external number is transferred; external sources supply mechanism form only.", "training_recipe": "frozen_walltime_5min_h200_ten_shard"}, "status": "deprecated", "tags": [], "version": 1}
{"assumptions": ["Dense parameter share is the right dilution measure -- itself questionable, and now moot."], "causal_chain": ["ASSERTED, now refuted: refinements act only on the dense path.", "ASSERTED: the dense path is 3.2% of parameters, so any effect is diluted roughly 30x.", "TEST: vary the dense share 11x by changing n-gram table size, holding the refinement fixed.", "RESULT: the effect did not scale with dense share. The premise fails."], "claim_ids": [], "competing_mechanism_ids": [], "description": "The replacement explanation for the null refinements, refuted one block after it was written by turning the dilution factor into a knob: an 11x change in dense share moved the measured effect from +0.000079 to -0.000149, both noise. The null is now recorded as UNEXPLAINED rather than assigned to the last surviving guess.", "fingerprint": "6482e205f433c14a", "intervention_predictions": [{"expected_change": "REFUTED. The high-dilution end of the 11x range.", "intervention_id": "int_ngram_table_mult_128"}, {"expected_change": "REFUTED. The low-dilution end. STANDING OPEN QUESTION: the null refinements now have NO accepted mechanism. Recorded as open rather than closed -- two explanations dying is evidence the framing is wrong, not that a third explanation is due.", "intervention_id": "int_ngram_table_mult_256"}], "mechanism_id": "mech_refinement_null_from_dilution", "name": "REFUTED: intrinsic refinements are null because the dense path is 3.2% of parameters", "notes": "", "observable_predictions": [{"expected_pattern": "Refinement effect should scale with dense parameter share. Across an 11x range it moved from +0.000079 to -0.000149 -- no scaling, both inside noise.", "observable_id": "obs_val_loss"}], "observation_ids": [], "origin_type": "self_proposed", "scope": {"attention_backend": "fa3", "decision_frame": "walltime_5min_h200", "domain": "transformer_lm_pretraining", "hardware": "H200", "local_extrapolation": "Derived from this campaign's own paired measurements on the compiled production path. No external number is transferred; external sources supply mechanism form only.", "training_recipe": "frozen_walltime_5min_h200_ten_shard"}, "status": "deprecated", "tags": [], "version": 1}
{"assumptions": ["Paired sd is roughly stable across blocks -- observed 0.00133 to 0.00153."], "causal_chain": ["E[max of k standard normals] = 1.029 sigma at k=4; at n=4 and sd 0.00133 that is 0.26 gates here.", "Selecting an arm and reporting it at its selected value therefore inflates it.", "PREDICTION THAT FAILED: disjoint-seed re-measurement should read systematically LOW.", "E29 (disjoint) read 0.60. E31 (equally disjoint) read 1.07. Only one direction was predicted.", "Between-block spread matches n=10 sampling noise, so no bias term is needed to explain it.", "I attributed a single low draw to a mechanism because I had just computed a number that matched it."], "claim_ids": [], "competing_mechanism_ids": [], "description": "The ARITHMETIC survives: a 4-arm sweep at n=4 inflates its winner by ~0.26 gates, additive across stacked selections. The ATTRIBUTION does not. E31, equally disjoint from every selection sweep, read 1.07 gates against E29's 0.60. One disjoint block low, one high -- the spread is sampling noise (between-block sd 0.000690 against 0.000459 expected at n=10). Replaced by a resolution claim: at n=10 this frame cannot distinguish 0.60 gates from 1.07.", "fingerprint": "59a239c56278491c", "intervention_predictions": [{"expected_change": "SURVIVES: 'selection and confirmation never share draws' is correct and cheap regardless of whether it explained this episode, and it caught the E28 retraction. SUPERSEDED BY: min_seeds=10 resolves large effects and cannot resolve effects near the floor -- a statement about resolution, not bias, and the one the final n=97 result vindicated.", "intervention_id": "int_depth6_dim640"}], "mechanism_id": "mech_winner_selection_inflation", "name": "CHALLENGED: winner-selection inflation explains shrinking interim results", "notes": "", "observable_predictions": [{"expected_pattern": "Selected winners should regress on disjoint seeds. Observed once (0.60), not observed once (1.07), out of two chances. At n=97 the pooled value is 0.93 gates -- between them, which is what sampling noise, and not bias, predicts.", "observable_id": "obs_val_loss"}], "observation_ids": [], "origin_type": "mixed", "scope": {"attention_backend": "fa3", "decision_frame": "walltime_5min_h200", "domain": "transformer_lm_pretraining", "hardware": "H200", "local_extrapolation": "Derived from this campaign's own paired measurements on the compiled production path. No external number is transferred; external sources supply mechanism form only.", "training_recipe": "frozen_walltime_5min_h200_ten_shard"}, "status": "challenged", "tags": [], "version": 1}
{"assumptions": ["The source's method is well specified in the detail it omits, and per-sequence is what it means.", "The n-gram hashes are genuinely label-independent -- verified in the implementation."], "causal_chain": ["Frozen corpus plus a 2.3-pass cliff means the only remaining lever is reducing the harm of repetition.", "Input-space augmentation changes token IDs, which changes n-gram hash keys -- inadmissible here.", "Label-only offset prediction leaves inputs and hashes untouched, so it is admissible.", "With offsets drawn PER TOKEN the model cannot infer which offset it is being scored on.", "The Bayes-optimal prediction becomes a mixture over offsets, blurring the next-token estimate.", "With offsets drawn PER SEQUENCE the offset is inferable from context, so the target stays identifiable.", "Our null is therefore evidence about our sampling choice, not about the method."], "claim_ids": [], "competing_mechanism_ids": [], "description": "Training-time augmentation is the only surviving route to making repetition less harmful, because the corpus is frozen and masking or permutation corrupt the token-ID hashes that are 96.8% of the model. Label-only offset prediction is the one admissible form. Our instantiation failed. The source omits whether the offset is drawn per token or per sequence; we chose per token, which makes the target a mixture over offsets and the Bayes-optimal output a blur. UNTESTED, NOT REFUTED.", "fingerprint": "66a1f9b8a737d1fc", "intervention_predictions": [{"expected_change": "THE EXPERIMENT. Offset drawn ONCE PER SEQUENCE, T in {2,4}, n=10 paired seeds against the frozen defaults, interleaved across GPUs. KILL CRITERION fixed in advance: if per-sequence is also null at n=10, the augmentation family is closed for this frame and unfreezing the corpus is the only honest next move.", "intervention_id": "int_offset_aug_per_sequence"}], "mechanism_id": "mech_label_offset_augmentation_identifiability", "name": "PROPOSED: per-token offset sampling makes the augmented target unidentifiable", "notes": "", "observable_predictions": [{"expected_pattern": "Per-token offsets degrade monotonically in the offset temperature T, because higher T widens the mixture. Per-sequence offsets should be roughly FLAT in T over {2,4}, because the target stays identifiable at every T. That contrast is the discriminating test.", "observable_id": "obs_val_loss"}, {"expected_pattern": "Under per-token sampling the degradation should be roughly uniform across position bins; under per-sequence it should concentrate early in the sequence, where context is too short to infer the offset.", "observable_id": "obs_val_nats_by_pos_bin"}], "observation_ids": [], "origin_type": "mixed", "scope": {"attention_backend": "fa3", "decision_frame": "walltime_5min_h200", "domain": "transformer_lm_pretraining", "hardware": "H200", "local_extrapolation": "Derived from this campaign's own paired measurements on the compiled production path. No external number is transferred; external sources supply mechanism form only.", "training_recipe": "frozen_walltime_5min_h200_ten_shard"}, "status": "proposed", "tags": [], "version": 1}
{"assumptions": ["Train/val gap is a valid memorisation proxy at this scale.", "NGRAM_WD_LAMBDA reaches the intended parameters. Verified only after E14 swept WEIGHT_DECAY, which touches 3.2% of the model, while blaming the 96.8% that it never reached."], "causal_chain": ["Depth 5 reaches the LOWEST train loss of any depth (2.4927) and the WORST val loss (2.7722).", "That gap is the signature of memorisation, and the n-gram table is where the capacity lives.", "Decaying the tables should therefore close the gap -- and it does, by 93% (+0.2795 -> +0.0201).", "But the ENDPOINT still degrades, at both depths tested.", "A hashed table stores a rare-key memorisation and a frequent-key statistic in rows drawn from one hash space; a norm penalty is indifferent between them.", "So closing the gap and improving the endpoint are not the same operation in this architecture."], "claim_ids": [], "competing_mechanism_ids": [], "description": "2.82e9 hashed n-gram parameters are 96.8% of the model. Overfitting and capability live in the same rows, so any norm-based penalty that suppresses memorisation also suppresses retrieval. This closes the entire weight-space-regularisation family, not one knob -- which is why it is worth more than the negative result that produced it.", "fingerprint": "18609eba0e10d1d6", "intervention_predictions": [{"expected_change": "CONFIRMED. 93% gap closure with endpoint degradation at two depths.", "intervention_id": "int_ngram_table_wd"}, {"expected_change": "REFUTABLE, UNTESTED, THE ONE SURVIVOR. A penalty that can DISTINGUISH the two row populations should close the gap AND improve the endpoint. Never run. If it is null, the weight-space family is closed on evidence rather than on argument.", "intervention_id": "int_ngram_count_conditioned_decay"}], "mechanism_id": "mech_memoriser_is_the_model", "name": "In a hashed n-gram memory the memorising rows ARE the signal-carrying rows", "notes": "v2: observation provenance added. v1 cited none and the audit was right to flag it. evd_obs_ngram_memorizer_data_scaling is the round-68 finding that disabling the n-gram memory makes val_bpb nearly flat across data volume (range 0.0035) while the full memory carries the entire data-sensitivity (range 0.1179), with the memory's contribution inverting from -0.029 at 10 shards to +0.086 at 5 -- i.e. the memory is a memorisation mechanism. That is the observation this mechanism generalises. The 2026-08-01 depth-5 and table-decay measurements that sharpened it are NOT citable here: they were collected by direct SSH and have no RunRecord, so they cannot become ObservationRecords.", "observable_predictions": [{"expected_pattern": "Uniform table decay closes 93% of the gap: +0.2795 -> +0.0201.", "observable_id": "obs_train_val_gap"}, {"expected_pattern": "The endpoint nonetheless DEGRADES at both depths. Gap closure and endpoint improvement decouple -- that decoupling is the whole mechanism.", "observable_id": "obs_val_loss"}, {"expected_pattern": "DISCRIMINATING AND UNRUN: under uniform decay the loss increase should be concentrated in the RARE-token deciles, where the memorising rows live. If the increase is uniform across deciles, the row populations are not frequency-separated and N2 cannot work.", "observable_id": "obs_val_nats_by_freq_decile"}], "observation_ids": ["evd_obs_ngram_memorizer_data_scaling"], "origin_type": "self_proposed", "scope": {"attention_backend": "fa3", "decision_frame": "walltime_5min_h200", "domain": "transformer_lm_pretraining", "hardware": "H200", "local_extrapolation": "Derived from this campaign's own paired measurements on the compiled production path. No external number is transferred; external sources supply mechanism form only.", "training_recipe": "frozen_walltime_5min_h200_ten_shard"}, "status": "active", "tags": [], "version": 2}
