# --- Python / env -----------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.DS_Store

# --- secrets ----------------------------------------------------------------
.env

# --- per-operator runtime state ---------------------------------------------
# runs/ is this operator's campaign: queue, generated variants, health and gate
# snapshots, logs, work directories. That IS machine- and host-specific and is not the
# shared artifact.
#
# RESULT RECORDS ARE THE EXCEPTION, and the exception matters. papers/ makes claims whose
# every number tools/coe.py audits against a registry built ONLY from
# runs/sweep/results/*.json. With those ignored, a fresh clone cannot rebuild the registry
# and cannot run the audit at all: E1 reports 706 problems, E5 finds all 117 paper numbers
# uncheckable, and the chain of evidence -- the thing this project is chiefly about -- is
# intact on one laptop and broken for every reader. A provenance system whose provenance
# does not ship is a provenance system in name only.
#
# 552KB of JSON is a small price for a paper a stranger can check. The records are append-
# only and were never edited, so committing them is publishing evidence, not state.
runs/
!runs/sweep/results/
!runs/sweep/results/*.json
tmp/

# --- literature corpus ------------------------------------------------------
# Fetched full texts are large, re-fetchable with `tools/lit.py fetch`, and are
# third-party content. The corpus INDEX is derived and per-operator. What IS committed
# is the knowledge extracted from them -- claims, mechanisms, hypotheses, lessons --
# because that is the part a future run needs and cannot regenerate.
lit/sources/
lit/index.json
lit/ACTIVE_DIRECTION.json

# --- profiling captures -----------------------------------------------------
*.nsys-rep
*.qdstrm

# --- remote host config (address, login, port) ---
.ophis_host

# sharded screen scratch, merged into lit/index.json
lit/index_shard*.json
lit/*_progress.json
