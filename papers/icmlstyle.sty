% Self-contained approximation of the ICML author style (icml2024.sty is distributed
% by the conference and is not on CTAN, so it cannot be fetched here). Geometry, type
% size, column measure and heading treatment follow the ICML template.
\ProvidesPackage{icmlstyle}
\RequirePackage[letterpaper,margin=0.75in,top=1.0in,bottom=1.0in]{geometry}
\RequirePackage{times}
\RequirePackage{mathptmx}
\RequirePackage{multicol}
\RequirePackage{titlesec}
\RequirePackage{caption}
\setlength{\columnsep}{0.25in}
\captionsetup{font=small,labelfont=bf,skip=4pt}
\titleformat{\section}{\normalfont\large\bfseries}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{1.4ex plus .3ex}{0.7ex}
\titlespacing*{\subsection}{0pt}{1.1ex plus .2ex}{0.5ex}
\newcommand{\icmltitle}[1]{%
  \begin{center}\vspace*{-0.35in}
  {\LARGE\bfseries #1\par}\vspace{0.9ex}\end{center}}
\newcommand{\icmlauthor}[2]{%
  \begin{center}{\normalsize #1}\\[0.25ex]{\small\itshape #2}\end{center}\vspace{0.6ex}}
\newenvironment{icmlabstract}%
  {\begin{center}\begin{minipage}{0.92\textwidth}\small
   \begin{center}\textbf{Abstract}\end{center}\vspace{0.3ex}}%
  {\end{minipage}\end{center}\vspace{1.2ex}}
